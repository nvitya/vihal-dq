#elifdef MCU_ESP32C6

  #define MCUSF_C6
  use ./c6/esp32c6   reexport
  const MAX_CLOCK_SPEED : uint = 160000000

#else

  #error "Unknown RV32I-ESP32 MCU"

#endif

