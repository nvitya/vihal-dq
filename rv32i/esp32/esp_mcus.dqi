const HWCLK_IMPL  : rostr = "\{DQ.PKGNAME}/rv32i/esp32/impl/hwclk_esp"
const HWPINS_IMPL : rostr = "\{DQ.PKGNAME}/rv32i/esp32/impl/hwpins_esp"

