// VIHAL configuration

const(bool):
    CPU_RV32I    = true
    CPU_RV32IMAC = true
    MCUF_ESP     = true
    MCUSF_32C3   = true
endconst

const(uint):
    MCU_INTERNAL_RC_SPEED =  40000000  // using the crystal directly
    MAX_CLOCK_SPEED       = 160000000
endconst

struct vihal_esp_image_header:
    magic          : uint8
    segment_count  : uint8
    spi_mode       : uint8
    spi_speed_size : uint8
    entry_addr     : uint32
    wp_pin         : uint8
    spi_pin_drv    : [3] uint8
    chip_id        : uint16
    min_chip_rev   : uint8
    reserved       : [8] uint8
    hash_appended  : uint8
    load_addr      : uint32
    data_len       : uint32
endstruct

