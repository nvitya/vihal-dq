struct esp_gpio_out:
    REG          : [[regrw]]  uint32  
    SET          : [[regrw]]  uint32  
    CLR          : [[regrw]]  uint32  
endstruct

struct esp_gpio_enable:
    REG          : [[regrw]]  uint32  
