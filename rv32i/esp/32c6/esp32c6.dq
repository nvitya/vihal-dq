    CLR          : [[regrw]]  uint32  
endstruct

struct esp_gpio_irqstat:
    REG          : [[regrw]]  uint32  
    SET          : [[regrw]]  uint32  
    CLR          : [[regrw]]  uint32  
endstruct

struct esp_gpio:
    BT_SELECT    : [[regrw]]  uint32  
    OUT          :            esp_gpio_out
    _pad_010     :            [4] uint32
    ENABLE       :            esp_gpio_enable
    _pad_02C     :            [3] uint32
