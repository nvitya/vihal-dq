
// the user project must provide the "board" module, which should define the MCU registers and MCU defines !

use board      reexport  // the project must define this !

// VIHAL CPU/MCU constants

#if FirstBool(CPU_ARMM, false)

    #if FirstBool(CPU_ARM_M7F, false)
        use ^/armm/core_cm7             reexport

        const MCU_INTERNAL_RC_SPEED : uint = 8000000

    #elif FirstBool(CPU_ARM_M33, false)
        use ^/armm/core_cm33            reexport
    #elif FirstBool(CPU_ARM_M4, false)
        use ^/armm/core_cm4             reexport
    #elif FirstBool(CPU_ARM_M3, false)
        use ^/armm/core_cm3             reexport
    #elif FirstBool(CPU_ARM_M0PLUS, false)
        use ^/armm/core_cm0p            reexport
    #elif FirstBool(CPU_ARM_M0, false)
        use ^/armm/core_cm0             reexport
    #else
      #error "Unknown ARM CPU"
    #endif

#endif


#if FirstBool(CPU_RV32I, false)



#endif



#if not CPU_ARMM
    //qqcs
#endif

// Common variables

var SystemCoreClock : uint  [[section('.noinit')]]
