// Clock Configuration Constants

const(uint32):
    HWCLK_EXTCLK_BYPASS  = 0x80000000
    HWCLK_EXTCLK_MASK    = 0x0FFFFFFF
endconst

var SystemCoreClock : uint = 0 [[section('.noinit')]]

function HwclkInit(external_clock_hz : uint, target_speed_hz : uint) -> bool

implementation

use ^/platform

// merge mcu specific implementations


// STM32

function StartExcOscillator(aextspeed : uint):
    var crreg : uint = RCC.CR
    #ifdef @.RCC_CR_HSEBYP
        if aextspeed AND HWCLK_EXTCLK_BYPASS <> 0:
            crreg =OR= RCC_CR_HSEBYP
            RCC.CR = crreg
        endif
    #endif
    crreg =OR= RCC_CR_HSEON
    RCC.CR = crreg

    while 0 == RCC.CR AND RCC_CR_HSERDY:
        // wait
    endwhile
endfunc

function PrepareHiSpeed(acpuspeed : uint):
    RCC.APB1ENR =OR= RCC_APB1ENR_PWREN  // Enable Power Control clock

    // The voltage scaling allows optimizing the power consumption when the
    // device is clocked below the maximum system frequency, to update the
    // voltage scaling value regarding system frequency refer to product
    // datasheet.

    // Enable the Over-drive to extend the clock frequency to 216 MHz
    PWR.CR1 =OR= PWR_CR1_ODEN
    while PWR.CSR1 AND PWR_CSR1_ODRDY == 0:
    endwhile

    // Enable the Over-drive switch
    PWR.CR1 =OR= PWR_CR1_ODSWEN
    while PWR.CSR1 AND PWR_CSR1_ODRDY == 0:
    endwhile

    PWR.CR1 =OR= PWR_CR1_VOS  // voltage scaling for maximum speed (Scale 1)

    // set Flash latency
    FLASH.ACR =AND= NOT FLASH_ACR_LATENCY
    FLASH.ACR =OR= FLASH_ACR_LATENCY_6WS

    FLASH.ACR =OR= FLASH_ACR_ARTEN OR FLASH_ACR_PRFTEN  // turn on the ART accelerator
endfunc

function IsDivisble(anum : uint, adivisor : uint) -> bool:
    var res : uint = anum IDIV adivisor
    return res * adivisor == anum
endfunc

function HwclkInit(external_clock_hz : uint, target_speed_hz : uint) -> bool:

    // select the HSI as clock source (required if this is called more times)

    var tmp : uint

    tmp = RCC.CFGR
    tmp =AND= NOT 3
    tmp =OR= RCC_CFGR_SW_HSI
    RCC.CFGR = tmp
    while (RCC.CFGR >> 2) AND 3 != RCC_CFGR_SW_HSI:
        // wait until it is set
    endwhile

    RCC.CR =AND= NOT RCC_CR_PLLON  // disable the PLL
    while RCC.CR AND RCC_CR_PLLRDY != 0:
        // Wait until the PLL is ready
    endwhile

    SystemCoreClock = MCU_INTERNAL_RC_SPEED // set the global variable for the fall error happens

    if target_speed_hz < 24000000: // minimum speed to use the PLL
        return target_speed_hz == MCU_INTERNAL_RC_SPEED
    endif

    PrepareHiSpeed(target_speed_hz)

    var basespeed : uint
    var pllsrc    : uint
    if external_clock_hz <> 0:
        StartExcOscillator(external_clock_hz)
        basespeed = (external_clock_hz AND HWCLK_EXTCLK_MASK)
        pllsrc = 1
    else:
        pllsrc = 0
        basespeed = MCU_INTERNAL_RC_SPEED
    endif

    var pllp     : uint = 2 // divide by 2 to get the final CPU speed
    var vcospeed : uint = target_speed_hz * pllp

    // use the minimal VCO speed
    while vcospeed < 192000000:
        pllp += 2
        vcospeed = target_speed_hz * pllp
    endwhile

    // try to find a speed for the USB
    while not IsDivisble(vcospeed, 48000000)  and  target_speed_hz * (pllp + 2) <= 432000000:
        pllp += 2
        vcospeed = target_speed_hz * pllp
    endwhile

    var pll_input_freq : uint = 2000000
    if (external_clock_hz IDIV 1000000) AND 1 <> 0:  // is the input MHz divisible by 2 ?
        pll_input_freq = 1000000
    endif
    var pllm : uint = basespeed IDIV pll_input_freq   // generate 1-2 MHz VCO input
    var plln : uint = vcospeed  IDIV pll_input_freq   // the vco multiplier
    var pllq : uint = vcospeed  IDIV 48000000          // usb speed

    RCC.PLLCFGR = (
           (pllsrc << 22)  // select PLL source
        OR (pllm   <<  0)
        OR (plln   <<  6)
        OR (((pllp >> 1) - 1) << 16)
        OR (pllq   << 24)
    )

    RCC.CR =OR= RCC_CR_PLLON  // enable the PLL
    while  RCC.CR AND RCC_CR_PLLRDY == 0:
        // Wait till PLL is ready
    endwhile

    // select bus dividers AHB=1, ABP1=4, APB2=2
    tmp = RCC.CFGR
    tmp =AND= NOT (RCC_CFGR_HPRE OR RCC_CFGR_PPRE1 OR RCC_CFGR_PPRE2)
    tmp =OR= (RCC_CFGR_HPRE_DIV1 OR RCC_CFGR_PPRE1_DIV4 OR RCC_CFGR_PPRE2_DIV2)
    RCC.CFGR = tmp

    // Select PLL as system clock source

    tmp =AND= NOT 3
    tmp =OR= RCC_CFGR_SW_PLL
    RCC.CFGR = tmp
    while (RCC.CFGR >> 2) AND 3 != RCC_CFGR_SW_PLL:
        // wait until it is set
    endwhile

    #ifdef @.MCUSF_F7
        RCC.DCKCFGR2 =AND= NOT (RCC_DCKCFGR2_CK48MSEL) // select the 48 MHz from the PLL
    #endif

    SystemCoreClock = target_speed_hz

    return true
endfunc
