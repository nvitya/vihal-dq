    Reserved3    : [[regro]]  [19] uint32
    ACC_WPMR     : [[regrw]]  uint32  
    ACC_WPSR     : [[regro]]  uint32  
    Reserved4    : [[regro]]  [4] uint32
    ACC_VER      : [[regro]]  uint32  
endstruct

const(uint32):
    ACC_CR_SWRST         = (0x1 << 0)
    ACC_MR_SELMINUS_Pos  = 0
    ACC_MR_SELMINUS_Msk  = (0x7 << ACC_MR_SELMINUS_Pos)
    ACC_MR_SELMINUS_TS   = (0x0 << 0)
