struct Acc:
    ACC_CR       : [[regwo]]  uint32  
    ACC_MR       : [[regrw]]  uint32  
    Reserved1    : [[regro]]  [7] uint32
    ACC_IER      : [[regwo]]  uint32  
    ACC_IDR      : [[regwo]]  uint32  
