    ACC_MR_SELMINUS_AFE0_AD3 = (0x7 << 0)
    ACC_MR_SELPLUS_Pos   = 4
    ACC_MR_SELPLUS_Msk   = (0x7 << ACC_MR_SELPLUS_Pos)
    ACC_MR_SELPLUS_AFE0_AD0 = (0x0 << 4)
    ACC_MR_SELPLUS_AFE0_AD1 = (0x1 << 4)
    ACC_MR_SELPLUS_AFE0_AD2 = (0x2 << 4)
    ACC_MR_SELPLUS_AFE0_AD3 = (0x3 << 4)
    ACC_MR_SELPLUS_AFE0_AD4 = (0x4 << 4)
    ACC_MR_SELPLUS_AFE0_AD5 = (0x5 << 4)
    ACC_MR_SELPLUS_AFE1_AD0 = (0x6 << 4)
    ACC_MR_SELPLUS_AFE1_AD1 = (0x7 << 4)
    ACC_MR_ACEN          = (0x1 << 8)
    ACC_MR_ACEN_DIS      = (0x0 << 8)
    ACC_MR_ACEN_EN       = (0x1 << 8)
    ACC_MR_EDGETYP_Pos   = 9
    ACC_MR_EDGETYP_Msk   = (0x3 << ACC_MR_EDGETYP_Pos)
    ACC_MR_EDGETYP_RISING = (0x0 << 9)
    ACC_MR_EDGETYP_FALLING = (0x1 << 9)
