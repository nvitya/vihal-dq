struct LPI2C_Type:
    VERID        : [[regro]]  uint32  
    PARAM        : [[regro]]  uint32  
    RESERVED_0   :            [8] uint8
    MCR          : [[regrw]]  uint32  
    MSR          : [[regrw]]  uint32  
    MIER         : [[regrw]]  uint32  
    MDER         : [[regrw]]  uint32  
    MCFGR0       : [[regrw]]  uint32  
    MCFGR1       : [[regrw]]  uint32  
    MCFGR2       : [[regrw]]  uint32  
    MCFGR3       : [[regrw]]  uint32  
    RESERVED_1   :            [16] uint8
    MDMR         : [[regrw]]  uint32  
    RESERVED_2   :            [4] uint8
    MCCR0        : [[regrw]]  uint32  
    RESERVED_3   :            [4] uint8
    MCCR1        : [[regrw]]  uint32  
    RESERVED_4   :            [4] uint8
    MFCR         : [[regrw]]  uint32  
    MFSR         : [[regro]]  uint32  
    MTDR         : [[regwo]]  uint32  
    RESERVED_5   :            [12] uint8
    MRDR         : [[regro]]  uint32  
    RESERVED_6   :            [156] uint8
    SCR          : [[regrw]]  uint32  
    SSR          : [[regrw]]  uint32  
    SIER         : [[regrw]]  uint32  
    SDER         : [[regrw]]  uint32  
    RESERVED_7   :            [4] uint8
    SCFGR1       : [[regrw]]  uint32  
    SCFGR2       : [[regrw]]  uint32  
    RESERVED_8   :            [20] uint8
    SAMR         : [[regrw]]  uint32  
    RESERVED_9   :            [12] uint8
    SASR         : [[regro]]  uint32  
    STAR         : [[regrw]]  uint32  
    RESERVED_10  :            [8] uint8
    STDR         : [[regwo]]  uint32  
    RESERVED_11  :            [12] uint8
    SRDR         : [[regro]]  uint32  
endstruct

