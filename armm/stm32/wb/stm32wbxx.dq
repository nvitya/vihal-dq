const(uint32):
    __STM32WBxx_CMSIS_VERSION_MAIN = 0x01
    __STM32WBxx_CMSIS_VERSION_SUB1 = 0x0A
    __STM32WBxx_CMSIS_VERSION_SUB2 = 0x00
    __STM32WBxx_CMSIS_VERSION_RC = 0x00
    __STM32WBxx_CMSIS_DEVICE_VERSION = ((__STM32WBxx_CMSIS_VERSION_MAIN << 24)                                                 | (__STM32WBxx_CMSIS_VERSION_SUB1 << 16)                                                 | (__STM32WBxx_CMSIS_VERSION_SUB2 << 8 )                                                 | (__STM32WBxx_CMSIS_VERSION_RC))
endconst

const(int):
    RESET                = 0
    SET                  = 1
    DISABLE              = 0
    ENABLE               = 1
endconst

const(int):
    SUCCESS              = 0
    ERROR                = 1
endconst

