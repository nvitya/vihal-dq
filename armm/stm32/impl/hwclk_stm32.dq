// STM32 implementation of CPU clock setup

use ^/core/pre/hwclk_pre  reexport

func HwClkInit(external_clock_hz : uint, target_speed_hz : uint) -> bool

implementation

use ^/platform

func StartExcOscillator(aextspeed : uint):
    var crreg : uint = RCC.CR
    #ifdef RCC_CR_HSEBYP
        if aextspeed & HWCLK_EXTCLK_BYPASS <> 0:
            crreg |= RCC_CR_HSEBYP
            RCC.CR = crreg
        endif
    #endif
    crreg |= RCC_CR_HSEON
    RCC.CR = crreg

    while 0 == RCC.CR & RCC_CR_HSERDY:
        // wait
    endwhile
endfunc

#if Defined(@.MCUSF_F0) or Defined(@.MCUSF_L0)

func PrepareHiSpeed(acpuspeed : uint):
    // Enable Prefetch Buffer and set Flash Latency
    #ifdef FLASH_ACR_PRFTBE
        FLASH.ACR = FLASH_ACR_PRFTBE | FLASH_ACR_LATENCY
    #else
        FLASH.ACR = FLASH_ACR_LATENCY | FLASH_ACR_PRFTEN
    #endif
endfunc

#elif Defined(@.MCUSF_F7)

func PrepareHiSpeed(acpuspeed : uint):
    RCC.APB1ENR |= RCC_APB1ENR_PWREN  // Enable Power Control clock

    // The voltage scaling allows optimizing the power consumption when the
    // device is clocked below the maximum system frequency, to update the
    // voltage scaling value regarding system frequency refer to product
    // datasheet.

    // Enable the Over-drive to extend the clock frequency to 216 MHz
    PWR.CR1 |= PWR_CR1_ODEN
    while PWR.CSR1 & PWR_CSR1_ODRDY == 0:
    endwhile

    // Enable the Over-drive switch
    PWR.CR1 |= PWR_CR1_ODSWEN
    while PWR.CSR1 & PWR_CSR1_ODRDY == 0:
    endwhile

    PWR.CR1 |= PWR_CR1_VOS  // voltage scaling for maximum speed (Scale 1)

    // set Flash latency
    FLASH.ACR &= ~ FLASH_ACR_LATENCY
    FLASH.ACR |= FLASH_ACR_LATENCY_6WS

    FLASH.ACR |= FLASH_ACR_ARTEN | FLASH_ACR_PRFTEN  // turn on the ART accelerator
endfunc

#else
    #error "PrepareHiSpeed() is not implmented for this MCU sub-family"
#endif

func IsDivisble(anum : uint, adivisor : uint) -> bool:
    var res : uint = anum div adivisor
    return res * adivisor == anum
endfunc

//---------------------------------------------------------------------------------------------------------------------------
#if Defined(@.MCUSF_F7)
//---------------------------------------------------------------------------------------------------------------------------

func HwClkInit(external_clock_hz : uint, target_speed_hz : uint) -> bool:

    // select the HSI as clock source (required if this is called more times)

    var tmp : uint

    tmp = RCC.CFGR
    tmp &= ~ 3
    tmp |= RCC_CFGR_SW_HSI
    RCC.CFGR = tmp
    while (RCC.CFGR >> 2) & 3 <> RCC_CFGR_SW_HSI:
        // wait until it is set
    endwhile

    RCC.CR &= ~ RCC_CR_PLLON  // disable the PLL
    while RCC.CR & RCC_CR_PLLRDY <> 0:
        // Wait until the PLL is ready
    endwhile

    SystemCoreClock = MCU_INTERNAL_RC_SPEED // set the global variable for the fall error happens

    if target_speed_hz < 24000000: // minimum speed to use the PLL
        return target_speed_hz == MCU_INTERNAL_RC_SPEED
    endif

    PrepareHiSpeed(target_speed_hz)

    var basespeed : uint
    var pllsrc    : uint
    if external_clock_hz <> 0:
        StartExcOscillator(external_clock_hz)
        basespeed = (external_clock_hz & HWCLK_EXTCLK_MASK)
        pllsrc = 1
    else:
        pllsrc = 0
        basespeed = MCU_INTERNAL_RC_SPEED
    endif

    var pllp     : uint = 2 // divide by 2 to get the final CPU speed
    var vcospeed : uint = target_speed_hz * pllp

    // use the minimal VCO speed
    while vcospeed < 192000000:
        pllp += 2
        vcospeed = target_speed_hz * pllp
    endwhile

    // try to find a speed for the USB
    while not IsDivisble(vcospeed, 48000000)  and  target_speed_hz * (pllp + 2) <= 432000000:
        pllp += 2
        vcospeed = target_speed_hz * pllp
    endwhile

    var pll_input_freq : uint = 2000000
    if (external_clock_hz div 1000000) & 1 <> 0:  // is the input MHz divisible by 2 ?
        pll_input_freq = 1000000
    endif
    var pllm : uint = basespeed div pll_input_freq   // generate 1-2 MHz VCO input
    var plln : uint = vcospeed  div pll_input_freq   // the vco multiplier
    var pllq : uint = vcospeed  div 48000000          // usb speed

    RCC.PLLCFGR = (0
        | (pllsrc << 22)  // select PLL source
        | (pllm   <<  0)
        | (plln   <<  6)
        | (((pllp >> 1) - 1) << 16)
        | (pllq   << 24)
    )

    RCC.CR |= RCC_CR_PLLON  // enable the PLL
    while  RCC.CR & RCC_CR_PLLRDY == 0:
        // Wait till PLL is ready
    endwhile

    // select bus dividers AHB=1, ABP1=4, APB2=2
    tmp = RCC.CFGR
    tmp &= ~ (RCC_CFGR_HPRE | RCC_CFGR_PPRE1 | RCC_CFGR_PPRE2)
    tmp |= (RCC_CFGR_HPRE_DIV1 | RCC_CFGR_PPRE1_DIV4 | RCC_CFGR_PPRE2_DIV2)
    RCC.CFGR = tmp

    // Select PLL as system clock source

    tmp &= ~ 3
    tmp |= RCC_CFGR_SW_PLL
    RCC.CFGR = tmp
    while (RCC.CFGR >> 2) & 3 <> RCC_CFGR_SW_PLL:
        // wait until it is set
    endwhile

    #ifdef MCUSF_F7
        RCC.DCKCFGR2 &= ~ (RCC_DCKCFGR2_CK48MSEL) // select the 48 MHz from the PLL
    #endif

    SystemCoreClock = target_speed_hz

    return true
endfunc

//---------------------------------------------------------------------------------------------------------------------------
#elif Defined(@.MCUSF_F0) or Defined(@.MCUSF_L0)
//---------------------------------------------------------------------------------------------------------------------------

func HwClkInit(external_clock_hz : uint, target_speed_hz : uint) -> bool:

    // select the HSI as clock source (required if this is called more times)

    var cfgr : uint

    cfgr = RCC.CFGR
    cfgr &= ~ 3
    cfgr |= RCC_CFGR_SW_HSI
    RCC.CFGR = cfgr
    while (RCC.CFGR >> 2) & 3 <> RCC_CFGR_SW_HSI:
        // wait until it is set
    endwhile

    RCC.CR &= ~ RCC_CR_PLLON  // disable the PLL
    while RCC.CR & RCC_CR_PLLRDY <> 0:
        // Wait until the PLL is ready
    endwhile

    SystemCoreClock = MCU_INTERNAL_RC_SPEED  // set the global variable for the fall error happens

    PrepareHiSpeed(target_speed_hz)

    var basespeed : uint
    var pllsrc    : uint
    if external_clock_hz <> 0:
        StartExcOscillator(external_clock_hz)
        basespeed = external_clock_hz & HWCLK_EXTCLK_MASK
    else:
        // the internal oscillator is usually 8 MHz, but it will be divided by 2 at the PLL input
        basespeed = (MCU_INTERNAL_RC_SPEED >> 1);
    endif

    var freqmul : uint = target_speed_hz div basespeed
    if freqmul < 2  or  freqmul > 16:
        return false
    endif

    cfgr = RCC.CFGR

    #if Defined(@.MCUSF_L0)

        // only a few combinations supported, but usually the max speed will be used.

        var plldiv : uint = 1  // = 2, using this fix value
        var pllmul : uint = 0

        if   freqmul ==  2:  pllmul = 1
        elif freqmul ==  3:  pllmul = 2
        elif freqmul ==  4:  pllmul = 3
        elif freqmul ==  5:  pllmul = 4
        elif freqmul ==  8:  pllmul = 5
        elif freqmul == 12:  pllmul = 6
        elif freqmul == 16:  pllmul = 7
        elif freqmul == 24:  pllmul = 8
        else:                pllmul = 0
        endif

        // do not divide the peripheral clocks:
        cfgr &= ~ (RCC_CFGR_HPRE | RCC_CFGR_PPRE1 | RCC_CFGR_PPRE2)

        /* PLL configuration = HSE * 6 = 48 MHz */
        cfgr &= ~ (RCC_CFGR_PLLSRC | RCC_CFGR_PLLDIV | RCC_CFGR_PLLMUL)
        cfgr |= (pllmul << 18) | (plldiv << 22)
        if external_clock_hz <> 0:
            cfgr |= RCC_CFGR_PLLSRC_HSE
        endif

    #else

        var pllmul : uint = (freqmul - 2) & 0xF  // STM32F0 multiplyer code

        // setup bus dividers AHB=1, PERIPH=1
        cfgr &= ~ (RCC_CFGR_HPRE | RCC_CFGR_PPRE)
        cfgr |= (RCC_CFGR_HPRE_DIV1 | RCC_CFGR_PPRE_DIV1)

        cfgr &= ~ (RCC_CFGR_PLLSRC | RCC_CFGR_PLLXTPRE | RCC_CFGR_PLLMUL)
        cfgr |= (pllmul << 18)

        if external_clock_hz <> 0:
            cfgr |= (RCC_CFGR_PLLSRC_HSE_PREDIV | RCC_CFGR_PLLXTPRE_HSE_PREDIV_DIV1)
        else:
            #ifdef RCC_CFGR_PLLSRC_HSI_DIV2
                cfgr |= RCC_CFGR_PLLSRC_HSI_DIV2
            #else
                cfgr |= RCC_CFGR_PLLSRC_HSI_PREDIV
            #endif
        endif

    #endif

    RCC.CFGR = cfgr

    RCC.CR |= RCC_CR_PLLON  // enable the PLL
    while RCC.CR & RCC_CR_PLLRDY == 0:
        // Wait till PLL is ready
    endwhile

    // Select PLL as system clock source
    cfgr &= ~ 3
    cfgr |= RCC_CFGR_SW_PLL
    RCC.CFGR = cfgr
    while (RCC.CFGR >> 2) & 3 <> RCC_CFGR_SW_PLL:
        // wait until it is set
    endwhile

    SystemCoreClock = target_speed_hz
    return true
endfunc

#else
    #error "HwClkInit() is not implmented for this MCU sub-family"
#endif