use ^/platform
use ^/core/pre/hwuart_pre  reexport

object OHwUart_impl(OHwUart_pre):

	regs : ^USART_TypeDef

	func Init(adevnum : int) -> bool

	func SetPeriphClock(aclk : uint) -> bool
	func SetBaudRate(abaudrate : int = 0) -> bool

	func TrySendByte(ach : byte) -> bool
	func TryRecvByte(rch : refout byte) -> bool
	func SendFinished() -> bool

    // Dma
/*
	func DmaAssign(istx : bool, admach : ^OHwDmaChannel)
	func DmaStartSend(THwDmaTransfer * axfer) -> bool
	func DmaStartRecv(THwDmaTransfer * axfer) -> bool
	func DmaSendCompleted() -> bool
	func DmaRecvCompleted() -> bool
*/
endobject

implementation

use ./stm32_utils

const(uint):
  #ifdef RCC_APB1ENR1_USART2EN
    RCC_APB1ENR_USART2EN = RCC_APB1ENR1_USART2EN
    RCC_APB1ENR_USART3EN = RCC_APB1ENR1_USART3EN
    RCC_APB1ENR_UART4EN  = RCC_APB1ENR1_UART4EN
    RCC_APB1ENR_UART5EN  = RCC_APB1ENR1_UART5EN
  #elifdef RCC_APBENR1_USART2EN
    RCC_APB2ENR_USART1EN  = RCC_APBENR2_USART1EN
    RCC_APB1ENR_USART2EN  = RCC_APBENR1_USART2EN
    RCC_APB1ENR_USART3EN  = RCC_APBENR1_USART3EN
    RCC_APB1ENR_USART5EN  = RCC_APBENR1_USART5EN
    RCC_APB1ENR_USART6EN  = RCC_APBENR1_USART6EN
    RCC_APB1ENR_LPUART1EN = RCC_APBENR1_LPUART1EN
  #elifdef RCC_APB1LENR_USART2EN
    RCC_APB1ENR_USART2EN  = RCC_APB1LENR_USART2EN
    RCC_APB1ENR_USART3EN  = RCC_APB1LENR_USART3EN
    RCC_APB1ENR_UART4EN   = RCC_APB1LENR_UART4EN
    RCC_APB1ENR_UART5EN   = RCC_APB1LENR_UART5EN
  #endif
endconst

func OHwUart_impl.Init(adevnum : int) -> bool:
	use *
	var code  : uint
	var busid : byte = STM32_BUSID_APB1

	devnum = adevnum
	initialized = false

	regs = nil

	if 0x101 == devnum  #{ifndef @.USART1_BASE}  or 1 == devnum  #{endif} :
	#ifdef LPUART1_BASE
    	regs = ^USART_TypeDef(LPUART1_BASE)
	  #ifdef RCC_APB1ENR2_LPUART1EN
		RCC.APB1ENR2 |= RCC_APB1ENR2_LPUART1EN
	  #else
       #ifdef RCC_APB4ENR_LPUART1EN
        RCC.APB4ENR |= RCC_APB4ENR_LPUART1EN
       #else
        APB1ENR_REGISTER |= RCC_APB1ENR_LPUART1EN
       #endif
	  #endif
	#endif // LPUART1 defined
  #ifdef USART1_BASE
	elif 1 == devnum:
        regs = ^USART_TypeDef(USART1_BASE)
        APB2ENR_REGISTER^ |= RCC_APB2ENR_USART1EN
        busid = STM32_BUSID_APB2
  #endif
  #ifdef USART2_BASE
	elif 2 == devnum:
		regs = ^USART_TypeDef(USART2_BASE)
		APB1ENR_REGISTER^ |= RCC_APB1ENR_USART2EN
  #endif
  #ifdef USART3_BASE
	elif 3 == devnum:
		regs = ^USART_TypeDef(USART3_BASE)
		APB1ENR_REGISTER^ |= RCC_APB1ENR_USART3EN
  #endif
  #ifdef UART4_BASE
	elif 4 == devnum:
		regs = ^USART_TypeDef(UART4_BASE)
		APB1ENR_REGISTER^ |= RCC_APB1ENR_UART4EN
  #endif
  #ifdef UART5_BASE
	elif 5 == devnum:
		regs = ^USART_TypeDef(UART5_BASE)
		APB1ENR_REGISTER^ |= RCC_APB1ENR_UART5EN
  #endif
  #ifdef USART5_BASE
	elif 5 == devnum:
		regs = ^USART_TypeDef(USART5_BASE)
		APB1ENR_REGISTER^ |= RCC_APB1ENR_USART5EN
  #endif
  #ifdef USART6_BASE
	elif 6 == devnum:
		regs = ^USART_TypeDef(USART6_BASE)
      #ifdef RCC_APBENR1_USART6EN
	    APB1ENR_REGISTER^ |= RCC_APBENR1_USART6EN
	  #else
		RCC.APB2ENR |= RCC_APB2ENR_USART6EN
		busid = STM32_BUSID_APB2
	  #endif
  #endif
    endif

	if regs == nil:
		return false;
	endif

	var cr1 : uint = regs.CR1
	var cr2 : uint = regs.CR2

	// disable UART in order to the CR registers
	cr1 &= ~USART_CR1_UE
	regs.CR1 = cr1

	// STOP BITS:
	code = 0 // = 1 stopbit
	if   1 == halfstopbits:  code = 1
	elif 3 == halfstopbits:  code = 3
	elif 4 == halfstopbits:  code = 2
    endif
	cr2 &= ~(3    << 12)
	cr2 |=  (code << 12)

	// DATA BITS = 8:
	var effdatabits : uint = databits

	// PARITY:
	code = 0 // parity off
	if parity:
		code |= 2
		if oddparity:
			code |= 1
		endif
		effdatabits += 1  // parity increases the effective data bits !
	endif
	cr1 &= ~(3    << 9)
	cr1 |=  (code << 9)

	code = 0 // = 8 databits
	if 7 == effdatabits:  code = 2;  endif
	if 9 == effdatabits:  code = 1;  endif
	cr1 &= ~((1 << 28) | (1 << 12))
	cr1 |= ((code & 1) << 12) | (((code >> 1) & 1) << 28)

  #ifdef USART_CR1_FIFOEN
    cr1 |= USART_CR1_FIFOEN
  #endif

	// Enable RX, TX:
	cr1 |= USART_CR1_TE | USART_CR1_RE

	// disable LIN and CLK out
  #ifdef USART_CR2_LINEN
    cr2 &= ~(USART_CR2_LINEN | USART_CR2_CLKEN)
    // disable hadware flow control and others:
    regs.CR3 &= ~(USART_CR3_RTSE | USART_CR3_CTSE | USART_CR3_SCEN | USART_CR3_HDSEL | USART_CR3_IREN)
  #else // e.g. F030
    cr2 &= ~USART_CR2_CLKEN
    // disable hadware flow control and others:
    regs.CR3 &= ~(USART_CR3_RTSE | USART_CR3_CTSE | USART_CR3_HDSEL)
  #endif

    #ifdef USART_PRESC_PRESCALER
        regs.PRESC = 0 // do not divide the input clock
    #endif

	regs.CR2 = cr2
	regs.CR1 = cr1  // the uart is still not enabled yet !

	periphclock = Stm32BusSpeed(busid);
	SetBaudRate();  // might change the CR1 !

	// Finally enable the the UART (locks the CR registers)
	regs.CR1 |= USART_CR1_UE

	initialized = true
	return true
endfunc

func OHwUart_impl.SetPeriphClock(aclk : uint) -> bool:
  	periphclock = aclk
  	return SetBaudRate()
endfunc

func OHwUart_impl.SetBaudRate(abaudrate : int) -> bool:
	use *
	if abaudrate > 0:
		baudrate = abaudrate
	endif

	var baseclock : uint = periphclock >> 4  // divide by 16
	var divider   : uint = ((baseclock << 4) + 8) div baudrate

	var tmp : uint = regs.CR1
	regs.CR1 = tmp & ~USART_CR1_UE

  #ifdef USART_CR1_OVER8
	if divider < 16:
		baseclock = periphclock >> 3  // divide by 8
		divider = ((baseclock << 4) + 8) div baudrate
		tmp |= USART_CR1_OVER8
		divider = ((divider & 0xFFF0) | ((divider & 0xE) >> 1))
	else:
		tmp &= ~USART_CR1_OVER8
	endif
	regs.CR1 = tmp & ~USART_CR1_UE
  #endif

	regs.BRR = divider
	regs.CR1 = tmp
	return true
endfunc

func OHwUart_impl.TrySendByte(ach : byte) -> bool:
	use *
  #ifdef USART_ISR_TXE
	if regs.ISR & USART_ISR_TXE == 0:
		return false
	endif
	regs.TDR = ach
  #elifdef USART_ISR_TXE_TXFNF
	if regs.ISR & USART_ISR_TXE_TXFNF == 0:
		return false
	endif
	regs.TDR = ach
  #else
	if regs.SR & USART_SR_TC == 0  and  regs.SR & USART_SR_TXE == 0:
		return false
	endif
	regs.DR = ach
  #endif
	return true
endfunc

func OHwUart_impl.TryRecvByte(rch : refout byte) -> bool:
	use *
  #ifdef USART_ISR_RXNE
	if regs.ISR & USART_ISR_RXNE <> 0:
		rch = regs.RDR
		return true
	else:
		return false
	endif
  #elifdef USART_ISR_RXNE_RXFNE
	if regs.ISR & USART_ISR_RXNE_RXFNE <> 0:
		rch = regs.RDR
		return true
	else:
		return false
	endif
  #else
	if regs.SR & USART_SR_RXNE <> 0
		rch = regs.DR
		return true
	else:
		return false
	endif
  #endif
endfunc

func OHwUart_impl.SendFinished() -> bool:
	use *
  #ifdef USART_ISR_TC
    // clear transfer complete flag, the flag is immediately set again if uart is idle
    regs.ICR = USART_ICR_CTSCF

    // __DSB grants that all explicit memory accesses before this instruction are completed
    __DSB()

	if regs.ISR & USART_ISR_TC <> 0:
  #else
	if regs.SR & USART_SR_IDLE <> 0:
  #endif
		return true
	else:
		return false
	endif
endfunc
