use ^/core/pre/hwpins_pre  reexport

function GpioPortEnable(aportnum : int) -> bool
function PinSetup(aportnum : int, apinnum : int, flags : uint) -> bool

object OGpioPin(OGpioPin_common):

    function *Create()  [[overload]]
    function *Create(aportnum : int, apinnum : int, ainvert : bool)  [[overload]]

    function Assign(aportnum : int, apinnum : int, ainvert : bool)
    function Setup(flags : uint) -> bool

endobj

implementation

use ^/platform

#ifdef   @.GPIOP_BASE
  const MAX_PORT_NUMBER : int = 16
#elifdef @.GPIOO_BASE
  const MAX_PORT_NUMBER : int = 15
#elifdef @.GPION_BASE
  const MAX_PORT_NUMBER : int = 14
#elifdef @.GPIOM_BASE
  const MAX_PORT_NUMBER : int = 13
#elifdef @.GPIOL_BASE
  const MAX_PORT_NUMBER : int = 12
#elifdef @.GPIOK_BASE
  const MAX_PORT_NUMBER : int = 11
#elifdef @.GPIOJ_BASE
  const MAX_PORT_NUMBER : int = 10
#elifdef @.GPIOI_BASE
  const MAX_PORT_NUMBER : int = 9
#elifdef @.GPIOH_BASE
  const MAX_PORT_NUMBER : int = 8
#elifdef @.GPIOG_BASE
  const MAX_PORT_NUMBER : int = 7
#elifdef @.GPIOF_BASE
  const MAX_PORT_NUMBER : int = 6
#elifdef @.GPIOE_BASE
  const MAX_PORT_NUMBER : int = 5
#elifdef @.GPIOC_BASE
  const MAX_PORT_NUMBER : int = 4
#else
  const MAX_PORT_NUMBER : int = 3
#endif

function GetGpioRegs(aportnum : int) -> ^GPIO_TypeDef:
	if aportnum < 0  or  aportnum >= MAX_PORT_NUMBER:
		return null
    endif
    return ^GPIO_TypeDef(GPIOA_BASE + (GPIOB_BASE-GPIOA_BASE) * aportnum)
endfunc

function GpioPortEnable(aportnum : int) -> bool:
	if aportnum < 0  or  aportnum >= MAX_PORT_NUMBER:
		return false
    endif
    #ifdef @.RCC_IOPENR_IOPAEN
        RCC.IOPENR |= RCC_IOPENR_IOPAEN << aportnum
    #elifdef @.RCC_AHBENR_GPIOAEN
        RCC.AHBENR |= RCC_AHBENR_GPIOAEN << aportnum
    #elifdef @.RCC_APB2ENR_IOPAEN
        RCC.APB2ENR |= RCC_APB2ENR_IOPAEN << aportnum
    #elifdef @.RCC_AHB2ENR_GPIOAEN
        RCC.AHB2ENR |= RCC_AHB2ENR_GPIOAEN << aportnum
    #elifdef @.RCC_AHB4ENR_GPIOAEN
        RCC.AHB4ENR |= RCC_AHB4ENR_GPIOAEN << aportnum
    #elifdef @.RCC_IOPENR_GPIOAEN
        RCC.IOPENR |= RCC_IOPENR_GPIOAEN << aportnum
    #else
        RCC.AHB1ENR |= RCC_AHB1ENR_GPIOAEN << aportnum
    #endif
    return true
endfunc

#ifdef @.MCUSF_F1

    #error "Pin setup for STM32F1 is not implemented yet"

#else

function PinSetup(aportnum : int, apinnum : int, flags : uint) -> bool:

    var regs : ^GPIO_TypeDef = GetGpioRegs(aportnum)
	if regs == null:
		return false
	endif

	if apinnum < 0  or  apinnum > 15:
		return false
	endif

	// 1. turn on port power
	GpioPortEnable(aportnum)

    var n : uint
    var pinx2 : int = apinnum * 2

    // set gpio initial state
    if flags & PINCFG_GPIO_INIT_1 <> 0:
      	regs.BSRR = (1 << apinnum)
    else:
        regs.BSRR = (0x10000 << apinnum)
    endif

    // set mode register
	if flags & PINCFG_AF_MASK <> 0:
		n = 2  // set alternate function mode
	elif flags & PINCFG_ANALOGUE <> 0:
		n = 3
	elif flags & PINCFG_OUTPUT <> 0:
		n = 1
	else:
	    n = 0
	endif
	regs.MODER &= ~(3 << pinx2)
	regs.MODER |=  (n << pinx2)

    // 3. set open-drain
    if flags & PINCFG_OPENDRAIN <> 0:
        regs.OTYPER |=  (1 << apinnum)
    else:
        regs.OTYPER &= ~(1 << apinnum)
    endif

    // 4. set pullup / pulldown
    regs.PUPDR &= ~(3 << pinx2)
    if flags & PINCFG_PULLUP <> 0:
        regs.PUPDR |= (1 << pinx2) // pullup
    elif flags & PINCFG_PULLDOWN <> 0:
        regs.PUPDR |= (2 << pinx2) // pulldown
    endif

    // 5. set speed
    regs.OSPEEDR &= ~(3 << pinx2)
    if flags & PINCFG_SPEED_MASK == PINCFG_SPEED_MEDIUM:
        regs.OSPEEDR |= (1 << pinx2)
    elif (flags & PINCFG_SPEED_MASK == PINCFG_SPEED_MED2)  or  (flags & PINCFG_SPEED_MASK == PINCFG_SPEED_FAST):
        regs.OSPEEDR |= (2 << pinx2)
    elif flags & PINCFG_SPEED_MASK == PINCFG_SPEED_VERYFAST:
        regs.OSPEEDR |= (3 << pinx2)  // this is very special, and does not even work for SDRAM pins
    endif

	if flags & PINCFG_AF_MASK <> 0:
		// set the alternate function
		n = (flags >> PINCFG_AF_SHIFT) & 0xF
		if apinnum < 8:
			regs.AFR[0] &= ~(0xF << (apinnum * 4))
			regs.AFR[0] |=  (n   << (apinnum * 4))
		else:
			regs.AFR[1] &= ~(0xF << ((apinnum-8) * 4))
			regs.AFR[1] |=  (n   << ((apinnum-8) * 4))
		endif
	endif

    return true
endfunc

#endif

function OGpioPin.*Create()  [[overload]]:
    inherited Create()
endfunc

function OGpioPin.*Create(aportnum : int, apinnum : int, ainvert : bool)  [[overload]]:
    inherited Create()
    Assign(aportnum, apinnum, ainvert)
endfunc

function OGpioPin.Assign(aportnum : int, apinnum : int, ainvert : bool):
    use .
    portnum  = aportnum
    pinnum   = apinnum
    inverted = ainvert

  	var regs : ^GPIO_TypeDef = GetGpioRegs(aportnum)
    if regs == null:
        return
    endif

    if apinnum < 0  or  apinnum > 15:
        return
    endif

    setbitptr    = %(regs.BSRR)
    clrbitptr    = %(regs.BSRR)
    getbitptr    = %(regs.IDR)
    getoutbitptr = %(regs.ODR)
    getbitshift  = apinnum

    if ainvert:
        setbitvalue = (1 << pinnum) << 16
        clrbitvalue = (1 << pinnum)
    else:
        setbitvalue = (1 << pinnum)
        clrbitvalue = (1 << pinnum) << 16
    endif
endfunc

function OGpioPin.Setup(flags : uint) -> bool:
    use .
	if inverted:
	  flags |= @.PINCFG_GPIO_INVERT
    endif
	return PinSetup(portnum, pinnum, flags)
endfunc
