#elif Defined(MCU_STM32H743) or Defined(MCU_STM32H743ZI)

  #define MCUSF_H7
  #include "./h7/stm32h743xx.dqi"
  const MCU_INTERNAL_RC_SPEED : uint =  64000000
  const MAX_CLOCK_SPEED       : uint = 400000000

#elif Defined(MCU_STM32H747) or Defined(MCU_STM32H747XI)

