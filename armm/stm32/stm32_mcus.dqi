// armm/stm32/stm32_mcus.dqi

// MCU configuration selector for STM32

#ifdef MCU_STM32F746

  #define MCUSF_F7
  #define CPU_ARM_M7F

  use ./f7/stm32f746   reexport

  const MCU_INTERNAL_RC_SPEED : uint = 16000000
  const MAX_CLOCK_SPEED : uint = 216000000

#elifdef MCU_STM32F070

  #define MCUSF_F0
  #define CPU_ARM_M0

  use ./f0/stm32f070   reexport

  const MCU_INTERNAL_RC_SPEED : uint = 8000000
  const MAX_CLOCK_SPEED : uint = 48000000

#else

  #error "Unknown ARMM-STM32 MCU"

#endif

//-------------------------------------------------------------------

#define MCUF_STM32

const HWCLK_IMPL  : rostr = "\{DQ.PKGNAME}/armm/stm32/impl/hwclk_stm32"
const HWPINS_IMPL : rostr = "\{DQ.PKGNAME}/armm/stm32/impl/hwpins_stm32"
const HWUART_IMPL : rostr = "\{DQ.PKGNAME}/armm/stm32/impl/hwuart_stm32"

// finish the vihal configuration with the platform
#include "../armm_platform.dqi"