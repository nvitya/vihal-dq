#{elif Defined(MCU_STM32G474) or Defined(MCU_STM32G473) or Defined(MCU_STM32G474RE)
       or Defined(MCU_STM32G473RE) or Defined(MCU_STM32G473CB) or Defined(MCU_STM32G473CE)
}
