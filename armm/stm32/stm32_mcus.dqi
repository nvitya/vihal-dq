// armm/stm32/stm32_mcus.dqi

// MCU configuration selector for STM32

#if false

// STM32F0: Cortex-M0

#elif Defined(MCU_STM32F030) or Defined(MCU_STM32F030F4)

  #define MCUSF_F0
  #include "./f0/stm32f030x6.dqi"
  const MCU_INTERNAL_RC_SPEED : uint =   8000000
  const MAX_CLOCK_SPEED       : uint =  48000000

#elif Defined(MCU_STM32F072) or Defined(MCU_STM32F072RB)

  #define MCUSF_F0
  #include "./f0/stm32f072xb.dqi"
  const MCU_INTERNAL_RC_SPEED : uint =   8000000
  const MAX_CLOCK_SPEED       : uint =  48000000

#elifdef MCU_STM32F070F6

  #define MCUSF_F0
