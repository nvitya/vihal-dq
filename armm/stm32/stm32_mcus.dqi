  #include "./h7/stm32h723xx.dqi"
  const MCU_INTERNAL_RC_SPEED : uint =  64000000
  const MAX_CLOCK_SPEED       : uint = 520000000  // actually 550 MHz with FREQ_BOOST

// STM32H7RS: Cortex-M7

#elif Defined(MCU_STM32H7S3) or Defined(MCU_STM32H7S3L8)

  #define MCUSF_H7RS
