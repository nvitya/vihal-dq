  const MAX_CLOCK_SPEED       : uint =  72000000

// STM32F3: Cortex-M4F

#elif Defined(MCU_STM32F301) or Defined(MCU_STM32F301C8) or Defined(MCU_STM32F301K6)

  #define MCUSF_F3
