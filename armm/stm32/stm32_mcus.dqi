#{elif Defined(MCU_STM32F405) or Defined(MCU_STM32F405RG) or Defined(MCU_STM32F405VE)
       or Defined(MCU_STM32F405VG) or Defined(MCU_STM32F405ZE) or Defined(MCU_STM32F405ZG)
