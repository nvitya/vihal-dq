struct DWT_Type:
    CTRL         : [[regrw]]  uint32    // Offset: 0x000 (R/W)  Control Register
    CYCCNT       : [[regrw]]  uint32    // Offset: 0x004 (R/W)  Cycle Count Register
    CPICNT       : [[regrw]]  uint32    // Offset: 0x008 (R/W)  CPI Count Register
    EXCCNT       : [[regrw]]  uint32    // Offset: 0x00C (R/W)  Exception Overhead Count Register
    SLEEPCNT     : [[regrw]]  uint32    // Offset: 0x010 (R/W)  Sleep Count Register
    LSUCNT       : [[regrw]]  uint32    // Offset: 0x014 (R/W)  LSU Count Register
    FOLDCNT      : [[regrw]]  uint32    // Offset: 0x018 (R/W)  Folded-instruction Count Register
    PCSR         : [[regro]]  uint32    // Offset: 0x01C (R/ )  Program Counter Sample Register
    COMP0        : [[regrw]]  uint32    // Offset: 0x020 (R/W)  Comparator Register 0
    MASK0        : [[regrw]]  uint32    // Offset: 0x024 (R/W)  Mask Register 0
    FUNCTION0    : [[regrw]]  uint32    // Offset: 0x028 (R/W)  Function Register 0
    RESERVED0    :            [1] uint32
    COMP1        : [[regrw]]  uint32    // Offset: 0x030 (R/W)  Comparator Register 1
    MASK1        : [[regrw]]  uint32    // Offset: 0x034 (R/W)  Mask Register 1
    FUNCTION1    : [[regrw]]  uint32    // Offset: 0x038 (R/W)  Function Register 1
    RESERVED1    :            [1] uint32
