const(uint32):
    SCS_BASE             = 0xE000E000
    ITM_BASE             = 0xE0000000
    DWT_BASE             = 0xE0001000
    TPI_BASE             = 0xE0040000
    CoreDebug_BASE       = 0xE000EDF0
    SysTick_BASE         = (SCS_BASE +  0x0010)
    NVIC_BASE            = (SCS_BASE +  0x0100)
    SCB_BASE             = (SCS_BASE +  0x0D00)
    MPU_BASE             = (SCS_BASE +  0x0D90)
endconst

const SCnSCB       :? = ^SCnSCB_Type(SCS_BASE)
const SCB          :? = ^SCB_Type(SCB_BASE)
const SysTick      :? = ^SysTick_Type(SysTick_BASE)
const NVIC         :? = ^NVIC_Type(NVIC_BASE)
const ITM          :? = ^ITM_Type(ITM_BASE)
const DWT          :? = ^DWT_Type(DWT_BASE)
const TPI          :? = ^TPI_Type(TPI_BASE)
const CoreDebug    :? = ^CoreDebug_Type(CoreDebug_BASE)
const MPU          :? = ^MPU_Type(MPU_BASE)

