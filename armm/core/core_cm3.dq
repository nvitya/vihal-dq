struct TPI_Type:
    SSPSR        : [[regro]]  uint32    // Offset: 0x000 (R/ )  Supported Parallel Port Size Register
    CSPSR        : [[regrw]]  uint32    // Offset: 0x004 (R/W)  Current Parallel Port Size Register
    RESERVED0    :            [2] uint32
    ACPR         : [[regrw]]  uint32    // Offset: 0x010 (R/W)  Asynchronous Clock Prescaler Register
    RESERVED1    :            [55] uint32
    SPPR         : [[regrw]]  uint32    // Offset: 0x0F0 (R/W)  Selected Pin Protocol Register
    RESERVED2    :            [131] uint32
    FFSR         : [[regro]]  uint32    // Offset: 0x300 (R/ )  Formatter and Flush Status Register
    FFCR         : [[regrw]]  uint32    // Offset: 0x304 (R/W)  Formatter and Flush Control Register
    FSCR         : [[regro]]  uint32    // Offset: 0x308 (R/ )  Formatter Synchronization Counter Register
    RESERVED3    :            [759] uint32
    TRIGGER      : [[regro]]  uint32    // Offset: 0xEE8 (R/ )  TRIGGER Register
    FIFO0        : [[regro]]  uint32    // Offset: 0xEEC (R/ )  Integration ETM Data
    ITATBCTR2    : [[regro]]  uint32    // Offset: 0xEF0 (R/ )  ITATBCTR2
    RESERVED4    :            [1] uint32
    ITATBCTR0    : [[regro]]  uint32    // Offset: 0xEF8 (R/ )  ITATBCTR0
    FIFO1        : [[regro]]  uint32    // Offset: 0xEFC (R/ )  Integration ITM Data
    ITCTRL       : [[regrw]]  uint32    // Offset: 0xF00 (R/W)  Integration Mode Control
    RESERVED5    :            [39] uint32
    CLAIMSET     : [[regrw]]  uint32    // Offset: 0xFA0 (R/W)  Claim tag set
    CLAIMCLR     : [[regrw]]  uint32    // Offset: 0xFA4 (R/W)  Claim tag clear
    RESERVED7    :            [8] uint32
    DEVID        : [[regro]]  uint32    // Offset: 0xFC8 (R/ )  TPIU_DEVID
    DEVTYPE      : [[regro]]  uint32    // Offset: 0xFCC (R/ )  TPIU_DEVTYPE
endstruct

