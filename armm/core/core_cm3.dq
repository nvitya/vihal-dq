struct ITM_Type:
    // unparsed: __OM  union
    u8           : [[regwo]]  uint8     // Offset: 0x000 ( /W)  ITM Stimulus Port 8-bit
    u16          : [[regwo]]  uint16    // Offset: 0x000 ( /W)  ITM Stimulus Port 16-bit
    u32          : [[regwo]]  uint32    // Offset: 0x000 ( /W)  ITM Stimulus Port 32-bit
    RESERVED0    :            [864] uint32
    TER          : [[regrw]]  uint32    // Offset: 0xE00 (R/W)  ITM Trace Enable Register
    RESERVED1    :            [15] uint32
    TPR          : [[regrw]]  uint32    // Offset: 0xE40 (R/W)  ITM Trace Privilege Register
    RESERVED2    :            [15] uint32
    TCR          : [[regrw]]  uint32    // Offset: 0xE80 (R/W)  ITM Trace Control Register
    RESERVED3    :            [32] uint32
    RESERVED4    :            [43] uint32
    LAR          : [[regwo]]  uint32    // Offset: 0xFB0 ( /W)  ITM Lock Access Register
    LSR          : [[regro]]  uint32    // Offset: 0xFB4 (R/ )  ITM Lock Status Register
    RESERVED5    :            [6] uint32
    PID4         : [[regro]]  uint32    // Offset: 0xFD0 (R/ )  ITM Peripheral Identification Register #4
    PID5         : [[regro]]  uint32    // Offset: 0xFD4 (R/ )  ITM Peripheral Identification Register #5
    PID6         : [[regro]]  uint32    // Offset: 0xFD8 (R/ )  ITM Peripheral Identification Register #6
    PID7         : [[regro]]  uint32    // Offset: 0xFDC (R/ )  ITM Peripheral Identification Register #7
    PID0         : [[regro]]  uint32    // Offset: 0xFE0 (R/ )  ITM Peripheral Identification Register #0
    PID1         : [[regro]]  uint32    // Offset: 0xFE4 (R/ )  ITM Peripheral Identification Register #1
    PID2         : [[regro]]  uint32    // Offset: 0xFE8 (R/ )  ITM Peripheral Identification Register #2
    PID3         : [[regro]]  uint32    // Offset: 0xFEC (R/ )  ITM Peripheral Identification Register #3
    CID0         : [[regro]]  uint32    // Offset: 0xFF0 (R/ )  ITM Component  Identification Register #0
    CID1         : [[regro]]  uint32    // Offset: 0xFF4 (R/ )  ITM Component  Identification Register #1
    CID2         : [[regro]]  uint32    // Offset: 0xFF8 (R/ )  ITM Component  Identification Register #2
    CID3         : [[regro]]  uint32    // Offset: 0xFFC (R/ )  ITM Component  Identification Register #3
endstruct

