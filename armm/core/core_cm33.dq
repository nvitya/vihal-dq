
struct NVIC_Type:
    ISER         : [[regrw]]  [16] uint32  // Offset: 0x000 (R/W)  Interrupt Set Enable Register
    RESERVED0    :            [16] uint32
    ICER         : [[regrw]]  [16] uint32  // Offset: 0x080 (R/W)  Interrupt Clear Enable Register
    RSERVED1     :            [16] uint32
    ISPR         : [[regrw]]  [16] uint32  // Offset: 0x100 (R/W)  Interrupt Set Pending Register
    RESERVED2    :            [16] uint32
    ICPR         : [[regrw]]  [16] uint32  // Offset: 0x180 (R/W)  Interrupt Clear Pending Register
    RESERVED3    :            [16] uint32
    IABR         : [[regrw]]  [16] uint32  // Offset: 0x200 (R/W)  Interrupt Active bit Register
    RESERVED4    :            [16] uint32
    ITNS         : [[regrw]]  [16] uint32  // Offset: 0x280 (R/W)  Interrupt Non-Secure State Register
    RESERVED5    :            [16] uint32
    IPR          : [[regrw]]  [496] uint8  // Offset: 0x300 (R/W)  Interrupt Priority Register (8Bit wide)
    RESERVED6    :            [580] uint32
    STIR         : [[regwo]]  uint32    // Offset: 0xE00 ( /W)  Software Trigger Interrupt Register
endstruct

const(uint32):
    NVIC_STIR_INTID_Pos  = 0
    NVIC_STIR_INTID_Msk  = 0x1FF
endconst

struct SCB_Type:
    CPUID        : [[regro]]  uint32    // Offset: 0x000 (R/ )  CPUID Base Register
    ICSR         : [[regrw]]  uint32    // Offset: 0x004 (R/W)  Interrupt Control and State Register
    VTOR         : [[regrw]]  uint32    // Offset: 0x008 (R/W)  Vector Table Offset Register
    AIRCR        : [[regrw]]  uint32    // Offset: 0x00C (R/W)  Application Interrupt and Reset Control Register
    SCR          : [[regrw]]  uint32    // Offset: 0x010 (R/W)  System Control Register
    CCR          : [[regrw]]  uint32    // Offset: 0x014 (R/W)  Configuration Control Register
    SHPR         : [[regrw]]  [12] uint8  // Offset: 0x018 (R/W)  System Handlers Priority Registers (4-7, 8-11, 12-15)
    SHCSR        : [[regrw]]  uint32    // Offset: 0x024 (R/W)  System Handler Control and State Register
    CFSR         : [[regrw]]  uint32    // Offset: 0x028 (R/W)  Configurable Fault Status Register
    HFSR         : [[regrw]]  uint32    // Offset: 0x02C (R/W)  HardFault Status Register
    DFSR         : [[regrw]]  uint32    // Offset: 0x030 (R/W)  Debug Fault Status Register
    MMFAR        : [[regrw]]  uint32    // Offset: 0x034 (R/W)  MemManage Fault Address Register
    BFAR         : [[regrw]]  uint32    // Offset: 0x038 (R/W)  BusFault Address Register
    AFSR         : [[regrw]]  uint32    // Offset: 0x03C (R/W)  Auxiliary Fault Status Register
    ID_PFR       : [[regro]]  [2] uint32  // Offset: 0x040 (R/ )  Processor Feature Register
    ID_DFR       : [[regro]]  uint32    // Offset: 0x048 (R/ )  Debug Feature Register
    ID_ADR       : [[regro]]  uint32    // Offset: 0x04C (R/ )  Auxiliary Feature Register
    ID_MMFR      : [[regro]]  [4] uint32  // Offset: 0x050 (R/ )  Memory Model Feature Register
    ID_ISAR      : [[regro]]  [6] uint32  // Offset: 0x060 (R/ )  Instruction Set Attributes Register
    CLIDR        : [[regro]]  uint32    // Offset: 0x078 (R/ )  Cache Level ID register
    CTR          : [[regro]]  uint32    // Offset: 0x07C (R/ )  Cache Type register
    CCSIDR       : [[regro]]  uint32    // Offset: 0x080 (R/ )  Cache Size ID Register
    CSSELR       : [[regrw]]  uint32    // Offset: 0x084 (R/W)  Cache Size Selection Register
    CPACR        : [[regrw]]  uint32    // Offset: 0x088 (R/W)  Coprocessor Access Control Register
    NSACR        : [[regrw]]  uint32    // Offset: 0x08C (R/W)  Non-Secure Access Control Register
    RESERVED3    :            [92] uint32
    STIR         : [[regwo]]  uint32    // Offset: 0x200 ( /W)  Software Triggered Interrupt Register
    RESERVED4    :            [15] uint32
    MVFR0        : [[regro]]  uint32    // Offset: 0x240 (R/ )  Media and VFP Feature Register 0
    MVFR1        : [[regro]]  uint32    // Offset: 0x244 (R/ )  Media and VFP Feature Register 1
    MVFR2        : [[regro]]  uint32    // Offset: 0x248 (R/ )  Media and VFP Feature Register 2
    RESERVED5    :            [1] uint32
    ICIALLU      : [[regwo]]  uint32    // Offset: 0x250 ( /W)  I-Cache Invalidate All to PoU
    RESERVED6    :            [1] uint32
    ICIMVAU      : [[regwo]]  uint32    // Offset: 0x258 ( /W)  I-Cache Invalidate by MVA to PoU
    DCIMVAC      : [[regwo]]  uint32    // Offset: 0x25C ( /W)  D-Cache Invalidate by MVA to PoC
    DCISW        : [[regwo]]  uint32    // Offset: 0x260 ( /W)  D-Cache Invalidate by Set-way
    DCCMVAU      : [[regwo]]  uint32    // Offset: 0x264 ( /W)  D-Cache Clean by MVA to PoU
    DCCMVAC      : [[regwo]]  uint32    // Offset: 0x268 ( /W)  D-Cache Clean by MVA to PoC
    DCCSW        : [[regwo]]  uint32    // Offset: 0x26C ( /W)  D-Cache Clean by Set-way
    DCCIMVAC     : [[regwo]]  uint32    // Offset: 0x270 ( /W)  D-Cache Clean and Invalidate by MVA to PoC
    DCCISW       : [[regwo]]  uint32    // Offset: 0x274 ( /W)  D-Cache Clean and Invalidate by Set-way
    BPIALL       : [[regwo]]  uint32    // Offset: 0x278 ( /W)  Branch Predictor Invalidate All
endstruct

