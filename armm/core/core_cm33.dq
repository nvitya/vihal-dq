    DCB_DEMCR_UMON_EN_Msk = (0x1 << DCB_DEMCR_UMON_EN_Pos)
    DCB_DEMCR_SDME_Pos   = 20
    DCB_DEMCR_SDME_Msk   = (0x1 << DCB_DEMCR_SDME_Pos)
    DCB_DEMCR_MON_REQ_Pos = 19
    DCB_DEMCR_MON_REQ_Msk = (0x1 << DCB_DEMCR_MON_REQ_Pos)
    DCB_DEMCR_MON_STEP_Pos = 18
    DCB_DEMCR_MON_STEP_Msk = (0x1 << DCB_DEMCR_MON_STEP_Pos)
    DCB_DEMCR_MON_PEND_Pos = 17
    DCB_DEMCR_MON_PEND_Msk = (0x1 << DCB_DEMCR_MON_PEND_Pos)
    DCB_DEMCR_MON_EN_Pos = 16
    DCB_DEMCR_MON_EN_Msk = (0x1 << DCB_DEMCR_MON_EN_Pos)
    DCB_DEMCR_VC_SFERR_Pos = 11
    DCB_DEMCR_VC_SFERR_Msk = (0x1 << DCB_DEMCR_VC_SFERR_Pos)
    DCB_DEMCR_VC_HARDERR_Pos = 10
    DCB_DEMCR_VC_HARDERR_Msk = (0x1 << DCB_DEMCR_VC_HARDERR_Pos)
    DCB_DEMCR_VC_INTERR_Pos = 9
    DCB_DEMCR_VC_INTERR_Msk = (0x1 << DCB_DEMCR_VC_INTERR_Pos)
    DCB_DEMCR_VC_BUSERR_Pos = 8
    DCB_DEMCR_VC_BUSERR_Msk = (0x1 << DCB_DEMCR_VC_BUSERR_Pos)
    DCB_DEMCR_VC_STATERR_Pos = 7
    DCB_DEMCR_VC_STATERR_Msk = (0x1 << DCB_DEMCR_VC_STATERR_Pos)
    DCB_DEMCR_VC_CHKERR_Pos = 6
    DCB_DEMCR_VC_CHKERR_Msk = (0x1 << DCB_DEMCR_VC_CHKERR_Pos)
    DCB_DEMCR_VC_NOCPERR_Pos = 5
    DCB_DEMCR_VC_NOCPERR_Msk = (0x1 << DCB_DEMCR_VC_NOCPERR_Pos)
endconst

const(uint32):
    DCB_DEMCR_VC_MMERR_Pos = 4
    DCB_DEMCR_VC_MMERR_Msk = (0x1 << DCB_DEMCR_VC_MMERR_Pos)
    DCB_DEMCR_VC_CORERESET_Pos = 0
    DCB_DEMCR_VC_CORERESET_Msk = 0x1
    DCB_DAUTHCTRL_INTSPNIDEN_Pos = 3
    DCB_DAUTHCTRL_INTSPNIDEN_Msk = (0x1 << DCB_DAUTHCTRL_INTSPNIDEN_Pos)
    DCB_DAUTHCTRL_SPNIDENSEL_Pos = 2
    DCB_DAUTHCTRL_SPNIDENSEL_Msk = (0x1 << DCB_DAUTHCTRL_SPNIDENSEL_Pos)
    DCB_DAUTHCTRL_INTSPIDEN_Pos = 1
    DCB_DAUTHCTRL_INTSPIDEN_Msk = (0x1 << DCB_DAUTHCTRL_INTSPIDEN_Pos)
    DCB_DAUTHCTRL_SPIDENSEL_Pos = 0
    DCB_DAUTHCTRL_SPIDENSEL_Msk = 0x1
    DCB_DSCSR_CDSKEY_Pos = 17
    DCB_DSCSR_CDSKEY_Msk = (0x1 << DCB_DSCSR_CDSKEY_Pos)
    DCB_DSCSR_CDS_Pos    = 16
    DCB_DSCSR_CDS_Msk    = (0x1 << DCB_DSCSR_CDS_Pos)
    DCB_DSCSR_SBRSEL_Pos = 1
    DCB_DSCSR_SBRSEL_Msk = (0x1 << DCB_DSCSR_SBRSEL_Pos)
    DCB_DSCSR_SBRSELEN_Pos = 0
    DCB_DSCSR_SBRSELEN_Msk = 0x1
endconst

struct DIB_Type:
    DLAR         : [[regwo]]  uint32    // Offset: 0x000 ( /W)  SCS Software Lock Access Register
    DLSR         : [[regro]]  uint32    // Offset: 0x004 (R/ )  SCS Software Lock Status Register
    DAUTHSTATUS  : [[regro]]  uint32    // Offset: 0x008 (R/ )  Debug Authentication Status Register
    DDEVARCH     : [[regro]]  uint32    // Offset: 0x00C (R/ )  SCS Device Architecture Register
    DDEVTYPE     : [[regro]]  uint32    // Offset: 0x010 (R/ )  SCS Device Type Register
endstruct

const(uint32):
    DIB_DLAR_KEY_Pos     = 0
    DIB_DLAR_KEY_Msk     = 0xFFFFFFFF
    DIB_DLSR_nTT_Pos     = 2
    DIB_DLSR_nTT_Msk     = (0x1 << DIB_DLSR_nTT_Pos )
    DIB_DLSR_SLK_Pos     = 1
    DIB_DLSR_SLK_Msk     = (0x1 << DIB_DLSR_SLK_Pos )
    DIB_DLSR_SLI_Pos     = 0
    DIB_DLSR_SLI_Msk     = 0x1
    DIB_DAUTHSTATUS_SNID_Pos = 6
    DIB_DAUTHSTATUS_SNID_Msk = (0x3 << DIB_DAUTHSTATUS_SNID_Pos )
    DIB_DAUTHSTATUS_SID_Pos = 4
    DIB_DAUTHSTATUS_SID_Msk = (0x3 << DIB_DAUTHSTATUS_SID_Pos )
    DIB_DAUTHSTATUS_NSNID_Pos = 2
    DIB_DAUTHSTATUS_NSNID_Msk = (0x3 << DIB_DAUTHSTATUS_NSNID_Pos )
    DIB_DAUTHSTATUS_NSID_Pos = 0
    DIB_DAUTHSTATUS_NSID_Msk = 0x3
    DIB_DDEVARCH_ARCHITECT_Pos = 21
    DIB_DDEVARCH_ARCHITECT_Msk = (0x7FF << DIB_DDEVARCH_ARCHITECT_Pos )
    DIB_DDEVARCH_PRESENT_Pos = 20
    DIB_DDEVARCH_PRESENT_Msk = (0x1F << DIB_DDEVARCH_PRESENT_Pos )
    DIB_DDEVARCH_REVISION_Pos = 16
    DIB_DDEVARCH_REVISION_Msk = (0xF << DIB_DDEVARCH_REVISION_Pos )
    DIB_DDEVARCH_ARCHVER_Pos = 12
    DIB_DDEVARCH_ARCHVER_Msk = (0xF << DIB_DDEVARCH_ARCHVER_Pos )
    DIB_DDEVARCH_ARCHPART_Pos = 0
    DIB_DDEVARCH_ARCHPART_Msk = 0xFFF
    DIB_DDEVTYPE_SUB_Pos = 4
    DIB_DDEVTYPE_SUB_Msk = (0xF << DIB_DDEVTYPE_SUB_Pos )
    DIB_DDEVTYPE_MAJOR_Pos = 0
    DIB_DDEVTYPE_MAJOR_Msk = 0xF
endconst

const(uint32):
    SCS_BASE             = 0xE000E000
    ITM_BASE             = 0xE0000000
    DWT_BASE             = 0xE0001000
    TPI_BASE             = 0xE0040000
    CoreDebug_BASE       = 0xE000EDF0
    DCB_BASE             = 0xE000EDF0
    DIB_BASE             = 0xE000EFB0
    SysTick_BASE         = (SCS_BASE +  0x0010)
    NVIC_BASE            = (SCS_BASE +  0x0100)
    SCB_BASE             = (SCS_BASE +  0x0D00)
    MPU_BASE             = (SCS_BASE +  0x0D90)
    SAU_BASE             = (SCS_BASE +  0x0DD0)
    FPU_BASE             = (SCS_BASE +  0x0F30)
endconst

const SCnSCB       :? = ^SCnSCB_Type(SCS_BASE)
const SCB          :? = ^SCB_Type(SCB_BASE)
const SysTick      :? = ^SysTick_Type(SysTick_BASE)
const NVIC         :? = ^NVIC_Type(NVIC_BASE)
const ITM          :? = ^ITM_Type(ITM_BASE)
const DWT          :? = ^DWT_Type(DWT_BASE)
const TPI          :? = ^TPI_Type(TPI_BASE)
const CoreDebug    :? = ^CoreDebug_Type(CoreDebug_BASE)
const DCB          :? = ^DCB_Type(DCB_BASE)
const DIB          :? = ^DIB_Type(DIB_BASE)
const MPU          :? = ^MPU_Type(MPU_BASE)
const SAU          :? = ^SAU_Type(SAU_BASE)
const FPU          :? = ^FPU_Type(FPU_BASE)

const(uint32):
    SCS_BASE_NS          = 0xE002E000
    CoreDebug_BASE_NS    = 0xE002EDF0
    DCB_BASE_NS          = 0xE002EDF0
    DIB_BASE_NS          = 0xE002EFB0
    SysTick_BASE_NS      = (SCS_BASE_NS +  0x0010)
    NVIC_BASE_NS         = (SCS_BASE_NS +  0x0100)
    SCB_BASE_NS          = (SCS_BASE_NS +  0x0D00)
    MPU_BASE_NS          = (SCS_BASE_NS +  0x0D90)
    FPU_BASE_NS          = (SCS_BASE_NS +  0x0F30)
endconst

const SCnSCB_NS    :? = ^SCnSCB_Type(SCS_BASE_NS)
const SCB_NS       :? = ^SCB_Type(SCB_BASE_NS)
const SysTick_NS   :? = ^SysTick_Type(SysTick_BASE)
const NVIC_NS      :? = ^NVIC_Type(NVIC_BASE_NS)
const CoreDebug_NS :? = ^CoreDebug_Type(CoreDebug_BASE_NS)
const DCB_NS       :? = ^DCB_Type(DCB_BASE_NS)
const DIB_NS       :? = ^DIB_Type(DIB_BASE_NS)
const MPU_NS       :? = ^MPU_Type(MPU_BASE_NS)
const FPU_NS       :? = ^FPU_Type(FPU_BASE_NS)

const(uint32):
    NVIC_USER_IRQ_OFFSET = 16
    FNC_RETURN           = 0xFEFFFFFF
    EXC_RETURN_PREFIX    = 0xFF000000
    EXC_RETURN_S         = 0x00000040
    EXC_RETURN_DCRS      = 0x00000020
    EXC_RETURN_FTYPE     = 0x00000010
    EXC_RETURN_MODE      = 0x00000008
    EXC_RETURN_SPSEL     = 0x00000004
    EXC_RETURN_ES        = 0x00000001
    EXC_INTEGRITY_SIGNATURE = 0xFEFA125A
    EXC_INTEGRITY_SIGNATURE = 0xFEFA125B
    ITM_RXBUFFER_EMPTY   = 0x5AA55AA5
endconst

