
var __stack : uint  [[external('__stack')]]

func _start(self_flash : int)  [[external('_start')]] ..

func soft_entry()  [[cexport, section('.startup'), asm]]:
    ldr    r0, =__stack
    mov    sp, r0

    movs   r0, #1
    ldr    r1, =_start  // use PC-relative register load first, to handle every jump size
    bx     r1
    .ltorg
endfunc

func cold_entry()  [[cexport, section('.startup'), asm]]:
    ldr    r0, =__stack
    mov    sp, r0

    movs   r0, #0
    ldr    r1, =_start  // use PC-relative register load first, to handle every jump size
    bx     r1
    .ltorg
endfunc

