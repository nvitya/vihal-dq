    PCKSIZE      : [[regrw]]  USB_DEVICE_PCKSIZE_Type
    EXTREG       : [[regrw]]  USB_DEVICE_EXTREG_Type
    STATUS_BK    : [[regrw]]  USB_DEVICE_STATUS_BK_Type
    Reserved1    :            [0x5] uint8
endstruct

struct UsbHostDescBank:
    ADDR         : [[regrw]]  USB_HOST_ADDR_Type
    PCKSIZE      : [[regrw]]  USB_HOST_PCKSIZE_Type
    EXTREG       : [[regrw]]  USB_HOST_EXTREG_Type
    STATUS_BK    : [[regrw]]  USB_HOST_STATUS_BK_Type
    Reserved1    :            [0x1] uint8
    CTRL_PIPE    : [[regrw]]  USB_HOST_CTRL_PIPE_Type
    STATUS_PIPE  : [[regrw]]  USB_HOST_STATUS_PIPE_Type
endstruct

struct UsbDeviceEndpoint:
    EPCFG        : [[regrw]]  USB_DEVICE_EPCFG_Type
    Reserved1    :            [0x3] uint8
    EPSTATUSCLR  : [[regwo]]  USB_DEVICE_EPSTATUSCLR_Type
    EPSTATUSSET  : [[regwo]]  USB_DEVICE_EPSTATUSSET_Type
    EPSTATUS     : [[regro]]  USB_DEVICE_EPSTATUS_Type
    EPINTFLAG    : [[regrw]]  USB_DEVICE_EPINTFLAG_Type
    EPINTENCLR   : [[regrw]]  USB_DEVICE_EPINTENCLR_Type
    EPINTENSET   : [[regrw]]  USB_DEVICE_EPINTENSET_Type
    Reserved2    :            [0x16] uint8
endstruct

struct UsbHostPipe:
    PCFG         : [[regrw]]  USB_HOST_PCFG_Type
    Reserved1    :            [0x2] uint8
    BINTERVAL    : [[regrw]]  USB_HOST_BINTERVAL_Type
    PSTATUSCLR   : [[regwo]]  USB_HOST_PSTATUSCLR_Type
    PSTATUSSET   : [[regwo]]  USB_HOST_PSTATUSSET_Type
    PSTATUS      : [[regro]]  USB_HOST_PSTATUS_Type
    PINTFLAG     : [[regrw]]  USB_HOST_PINTFLAG_Type
    PINTENCLR    : [[regrw]]  USB_HOST_PINTENCLR_Type
    PINTENSET    : [[regrw]]  USB_HOST_PINTENSET_Type
    Reserved2    :            [0x16] uint8
endstruct

struct UsbDevice:
    CTRLA        : [[regrw]]  USB_CTRLA_Type
    Reserved1    :            [0x1] uint8
    SYNCBUSY     : [[regro]]  USB_SYNCBUSY_Type
    QOSCTRL      : [[regrw]]  USB_QOSCTRL_Type
    Reserved2    :            [0x4] uint8
    CTRLB        : [[regrw]]  USB_DEVICE_CTRLB_Type
    DADD         : [[regrw]]  USB_DEVICE_DADD_Type
    Reserved3    :            [0x1] uint8
    STATUS       : [[regro]]  USB_DEVICE_STATUS_Type
