// DQ Register Definitions for the STM32F746

// VIHAL configuration

const(bool):
    CPU_ARMM       = true
    CPU_ARM_M0PLUS = true
    MCUF_RP        = true
    MCUSF_20       = true
endconst

const(uint32):
    SELF_FLASHING_SPI_ADDR = 0x001000
    SELF_FLASHING_RAM_ADDR = 0x21000000
endconst

// CMSIS Configuration

const(uint32):
    __CM0_REV            = 0
    __MPU_PRESENT        = 0
    __NVIC_PRIO_BITS     = 2
    __Vendor_SysTickConfig = 0
    __VTOR_PRESENT       = 1
endconst

//-------------------------------------------------------------------------------------------------
// INTERRUPTS
//-------------------------------------------------------------------------------------------------

// Standard Cortex-M interrupts

const(int):
    NonMaskableInt_IRQn  = -14  // 2 Non Maskable Interrupt
    HardFault_IRQn       = -13  // 3 Cortex-M0 Hard Fault Interrupt
    SVC_IRQn             = -5  // 11 Cortex-M0 SV Call Interrupt
    PendSV_IRQn          = -2  // 14 Cortex-M0 Pend SV Interrupt
    SysTick_IRQn         = -1  // 15 Cortex-M0 System Tick Interrupt
endconst

// Peripheral interrupts

const(int):
    TIMER_0_IRQn         = 0
    TIMER_1_IRQn         = 1
    TIMER_2_IRQn         = 2
    TIMER_3_IRQn         = 3
    PWM_WRAP_IRQn        = 4
    USBCTRL_IRQn         = 5
    XIP_IRQn             = 6
    PIO0_0_IRQn          = 7
    PIO0_1_IRQn          = 8
    PIO1_0_IRQn          = 9
    PIO1_1_IRQn          = 10
    DMA_0_IRQn           = 11
    DMA_1_IRQn           = 12
    IO_BANK0_IRQn        = 13
    IO_QSPI_IRQn         = 14
    SIO_PROC0_IRQn       = 15
    SIO_PROC1_IRQn       = 16
    CLOCKS_IRQn          = 17
    SPI0_IRQn            = 18
    SPI1_IRQn            = 19
    UART0_IRQn           = 20
    UART1_IRQn           = 21
    ADC_FIFO_IRQn        = 22
    I2C0_IRQn            = 23
    I2C1_IRQn            = 24
    RTC_IRQn             = 25
endconst


