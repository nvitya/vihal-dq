// Pin Configuration Constants

const(uint32):
    PORTNUM_A  =  0
    PORTNUM_B  =  1
    PORTNUM_C  =  2
    PORTNUM_D  =  3
    PORTNUM_E  =  4
    PORTNUM_F  =  5
    PORTNUM_G  =  6
    PORTNUM_H  =  7
    PORTNUM_I  =  8
    PORTNUM_J  =  9
    PORTNUM_K  = 10
    PORTNUM_L  = 11
    PORTNUM_M  = 12
    PORTNUM_N  = 13
    PORTNUM_O  = 14
    PORTNUM_P  = 15
endconst

const(uint32):
    PINCFG_INPUT          = 0x0000  // default
    PINCFG_OUTPUT         = 0x0001
    PINCFG_OPENDRAIN      = 0x0002
    PINCFG_PULLUP         = 0x0004
    PINCFG_PULLDOWN       = 0x0008
    PINCFG_ANALOGUE       = 0x0010

    PINCFG_DRIVE_NORMAL   = 0x0000  // default
    PINCFG_DRIVE_MEDIUM   = 0x0000
    PINCFG_DRIVE_WEAK     = 0x0020
    PINCFG_DRIVE_STRONG   = 0x0040
    PINCFG_DRIVE_MASK     = 0x0060

    PINCFG_SPEED_MASK     = 0x0F00
    PINCFG_SPEED_MEDIUM   = 0x0000  // default
    PINCFG_SPEED_SLOW     = 0x0100
    PINCFG_SPEED_MED2     = 0x0200
    PINCFG_SPEED_MEDIUM2  = 0x0200
    PINCFG_SPEED_FAST     = 0x0300
    PINCFG_SPEED_VERYFAST = 0x0400

    PINCFG_GPIO_INVERT    = 0x4000
    PINCFG_GPIO_INIT_1    = 0x8000
    PINCFG_GPIO_INIT_0    = 0x0000
endconst

const(uint32):
    PINCFG_AF_MASK   = 0x1F0000
    PINCFG_AF_SHIFT  = 16

    PINCFG_AF_0      = 0x100000
    PINCFG_AF_1      = 0x110000
    PINCFG_AF_2      = 0x120000
    PINCFG_AF_3      = 0x130000
    PINCFG_AF_4      = 0x140000
    PINCFG_AF_5      = 0x150000
    PINCFG_AF_6      = 0x160000
    PINCFG_AF_7      = 0x170000
    PINCFG_AF_8      = 0x180000
    PINCFG_AF_9      = 0x190000
    PINCFG_AF_10     = 0x1A0000
    PINCFG_AF_11     = 0x1B0000
    PINCFG_AF_12     = 0x1C0000
    PINCFG_AF_13     = 0x1D0000
    PINCFG_AF_14     = 0x1E0000
    PINCFG_AF_15     = 0x1F0000

    PINCFG_AF_A      = 0x100000
    PINCFG_AF_B      = 0x110000
    PINCFG_AF_C      = 0x120000
    PINCFG_AF_D      = 0x130000
    PINCFG_AF_E      = 0x140000
    PINCFG_AF_F      = 0x150000
    PINCFG_AF_G      = 0x160000
    PINCFG_AF_H      = 0x170000
    PINCFG_AF_I      = 0x180000
    PINCFG_AF_J      = 0x190000
    PINCFG_AF_K      = 0x1A0000
    PINCFG_AF_L      = 0x1B0000
    PINCFG_AF_M      = 0x1C0000
    PINCFG_AF_N      = 0x1D0000
    PINCFG_AF_O      = 0x1E0000
    PINCFG_AF_P      = 0x1F0000
endconst

function GpioPortEnable(aportnum : int) -> bool
function PinSetup(aportnum : int, apinnum : int, flags : uint) -> bool

object OGpioPin:
	pinnum   : byte = 0xFF
	portnum  : byte = 0xFF
	inverted : bool = false
    _pad1    : byte

    setbitptr    : ^uint32
    clrbitptr    : ^uint32
    getbitptr    : ^uint32
    getoutbitptr : ^uint32

    setbitvalue  : uint32
    clrbitvalue  : uint32
    getbitshift  : uint32

    function *Create(aportnum : int, apinnum : int, ainvert : bool)

    function Assign(aportnum : int, apinnum : int, ainvert : bool)
    function Setup(flags : uint) -> bool

	function Set1()  [[inline]]:
        setbitptr^ = setbitvalue
    endfunc

	function Set0()  [[inline]]:
        clrbitptr^ = clrbitvalue
    endfunc

	function SetTo(value : uint)  [[inline]]:
        if value AND 1 <> 0:
            Set1()
        else:
            Set0()
        endif
    endfunc

	function Value() -> byte:
        return (getbitptr^ >> getbitshift) AND 1
    endfunc

	function OutValue() -> byte:
        return (getoutbitptr^ >> getbitshift) AND 1
    endfunc
endobj

implementation

use ^/platform

const MAX_PORT_NUMBER : int = 7

function GetGpioRegs(aportnum : int) -> ^GPIO_TypeDef:
	if aportnum < 0  or  aportnum >= MAX_PORT_NUMBER:
		return null
    endif
    return ^GPIO_TypeDef(GPIOA_BASE + (GPIOB_BASE-GPIOA_BASE) * aportnum)
endfunc

function GpioPortEnable(aportnum : int) -> bool:
	if aportnum < 0  or  aportnum >= MAX_PORT_NUMBER:
		return false
    endif
    RCC.AHB1ENR =OR= (RCC_AHB1ENR_GPIOAEN << aportnum)
    return true
endfunc

function PinSetup(aportnum : int, apinnum : int, flags : uint) -> bool:

    var regs : ^GPIO_TypeDef = GetGpioRegs(aportnum)
	if regs == null:
		return false
	endif

	if apinnum < 0  or  apinnum > 15:
		return false
	endif

	// 1. turn on port power
	GpioPortEnable(aportnum)

    var n : uint
    var pinx2 : int = apinnum * 2

    // set gpio initial state
    if flags AND PINCFG_GPIO_INIT_1 <> 0:
      	regs.BSRR = (1 << apinnum)
    else:
        regs.BSRR = (0x10000 << apinnum)
    endif

    // set mode register
	if flags AND PINCFG_AF_MASK <> 0:
		n = 2  // set alternate function mode
	elif flags AND PINCFG_ANALOGUE <> 0:
		n = 3
	elif flags AND PINCFG_OUTPUT <> 0:
		n = 1
	else:
	    n = 0
	endif
	regs.MODER =AND= NOT (3 << pinx2)
	regs.MODER =OR=      (n << pinx2)

    // 3. set open-drain
    if flags AND PINCFG_OPENDRAIN <> 0:
        regs.OTYPER =OR= (1 << apinnum)
    else:
        regs.OTYPER =AND= NOT (1 << apinnum)
    endif

    // 4. set pullup / pulldown
    regs.PUPDR =AND= NOT (3 << pinx2)
    if flags AND PINCFG_PULLUP <> 0:
        regs.PUPDR =OR= (1 << pinx2) // pullup
    elif flags AND PINCFG_PULLDOWN <> 0:
        regs.PUPDR =OR= (2 << pinx2) // pulldown
    endif

    // 5. set speed
    regs.OSPEEDR =AND= NOT (3 << pinx2)
    if flags AND PINCFG_SPEED_MASK == PINCFG_SPEED_MEDIUM:
        regs.OSPEEDR =OR= (1 << pinx2)
    elif (flags AND PINCFG_SPEED_MASK == PINCFG_SPEED_MED2)  or  (flags AND PINCFG_SPEED_MASK == PINCFG_SPEED_FAST):
        regs.OSPEEDR =OR= (2 << pinx2)
    elif flags AND PINCFG_SPEED_MASK == PINCFG_SPEED_VERYFAST:
        regs.OSPEEDR =OR= (3 << pinx2)  // this is very special, and does not even work for SDRAM pins
    endif

	if flags AND PINCFG_AF_MASK <> 0:
		// set the alternate function
		n = (flags >> PINCFG_AF_SHIFT) AND 0xF
		if apinnum < 8:
			regs.AFR[0] =AND= NOT (0xF << (apinnum * 4))
			regs.AFR[0] =OR=      (n   << (apinnum * 4))
		else:
			regs.AFR[1] =AND= NOT (0xF << ((apinnum-8) * 4))
			regs.AFR[1] =OR=      (n   << ((apinnum-8) * 4))
		endif
	endif

    return true
endfunc

function OGpioPin.*Create(aportnum : int, apinnum : int, ainvert : bool):
    Assign(aportnum, apinnum, ainvert)
endfunc

function OGpioPin.Assign(aportnum : int, apinnum : int, ainvert : bool):
    use .
    portnum  = aportnum
    pinnum   = apinnum
    inverted = ainvert

  	var regs : ^GPIO_TypeDef = GetGpioRegs(aportnum)
    if regs == null:
        return
    endif

    if apinnum < 0  or  apinnum > 15:
        return
    endif

    setbitptr    = &(regs.BSRR)
    clrbitptr    = &(regs.BSRR)
    getbitptr    = &(regs.IDR)
    getoutbitptr = &(regs.ODR)
    getbitshift  = apinnum

    if ainvert:
        setbitvalue = (1 << pinnum) << 16
        clrbitvalue = (1 << pinnum)
    else:
        setbitvalue = (1 << pinnum)
        clrbitvalue = (1 << pinnum) << 16
    endif
endfunc

function OGpioPin.Setup(flags : uint) -> bool:
    use .
	if inverted:
	  flags =OR= PINCFG_GPIO_INVERT
    endif
	return PinSetup(portnum, pinnum, flags)
endfunc
