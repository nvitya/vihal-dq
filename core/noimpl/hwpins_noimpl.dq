
use ^/core/pre/hwpins_pre  reexport

object OGpioPin(OGpioPin_pre):

    func Assign(aportnum : int, apinnum : int, ainvert : bool):
        portnum  = aportnum
        pinnum   = apinnum
        inverted = ainvert
    endfunc

    func *Create()  [[overload]]:
    endfunc

    func *Create(aportnum : int, apinnum : int, ainvert : bool)  [[overload]]:
        Assign(aportnum, apinnum, ainvert)
    endfunc

    func Setup(flags : uint) -> bool:
        return false
    endfunc

	func Set1():
    endfunc

	func Set0():
    endfunc

	func SetTo(value : uint):
    endfunc

	func Value() -> byte:
        return 0
    endfunc

	func OutValue() -> byte:
        return 0
    endfunc
endobject

func GpioPortEnable(aportnum : int) -> bool:
    return false
endfunc

func PinSetup(aportnum : int, apinnum : int, flags : uint) -> bool:
    return false
endfunc
