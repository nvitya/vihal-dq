// DQ platform configuration include

// board/board.dq is already "used" in this context

// VIHAL CPU/MCU constants

#ifdef CPU_ARMM

  #ifdef CPU_ARM_M7F
    use ^/armm/core/core_cm7             reexport
  #elifdef CPU_ARM_M33
    use ^/armm/core/core_cm33            reexport
  #elifdef CPU_ARM_M4
    use ^/armm/core/core_cm4             reexport
  #elifdef CPU_ARM_M3
    use ^/armm/core/core_cm3             reexport
  #elifdef CPU_ARM_M0PLUS
    use ^/armm/core/core_cm0p            reexport
  #elifdef CPU_ARM_M0
    use ^/armm/core/core_cm0             reexport
  #else
    #error "Unknown ARM CPU"
  #endif

    use ^/armm/core/armm_instr   reexport
    use ./armm/core/armm_utils   reexport

#endif


#ifdef CPU_ARMA

#endif


#ifdef CPU_RV32I

    use ^/rv32i/core/rv32i_instr   reexport
    use ./rv32i/core/rv32i_utils   reexport

#endif

// Common variables

#ifndef MCU_INTERNAL_RC_SPEED
    const MCU_INTERNAL_RC_SPEED : uint = 4000000
#endif

var SystemCoreClock : uint  [[section('.noinit')]]

#ifdef BARE
  use ./core/c_system
#endif
