use vihal/core/pre/hwpins_pre  reexport

const(uint32):
    PINNUM_A0  =  0
    PINNUM_A1  =  1
    PINNUM_A2  =  2
    PINNUM_A3  =  3
    PINNUM_A4  =  4
    PINNUM_A5  =  5
    PINNUM_A6  =  6
    PINNUM_A7  =  7
