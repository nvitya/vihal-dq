use vihal/platform
use vihal/core/pre/hwuart_pre  reexport

object OHwUart_impl(OHwUart_pre):

	regs : ^UART_REG

	func Init(adevnum : int) -> bool ..

	func SetBaudRate(abaudrate : int = 0) -> bool ..

	func TrySendByte(ach : byte) -> bool ..
	func TryRecvByte(rch : refout byte) -> bool ..
	func SendFinished() -> bool ..
endobject

implementation

use ./rk_utils

func OHwUart_impl.Init(adevnum : int) -> bool:
    use *
    var tmp : uint32

    devnum = adevnum
    initialized = false
    regs = nil

    if 0 == devnum:
        map_hw_addr(UART0_BASE, SizeOf(UART_REG), ^pointer(%regs))
        cru_reg_set_field(0x82C, 4, 1, 0)  // sclk_uart0_src gate disable
        cru_reg_set_field(0x82C, 9, 1, 0)  // pclk_uart0 gate disable
    elif 1 == devnum:
        map_hw_addr(UART1_BASE, SizeOf(UART_REG), ^pointer(%regs))
        cru_reg_set_field(0x82C, 5, 1, 0)  // sclk_uart1_src gate disable
        cru_reg_set_field(0x82C, 10, 1, 0)  // pclk_uart1 gate disable
    elif 2 == devnum:
        map_hw_addr(UART2_BASE, SizeOf(UART_REG), ^pointer(%regs))
        cru_reg_set_field(0x82C, 6, 1, 0)  // sclk_uart2_src gate disable
        cru_reg_set_field(0x82C, 11, 1, 0)  // pclk_uart2 gate disable
    elif 3 == devnum:
        map_hw_addr(UART3_BASE, SizeOf(UART_REG), ^pointer(%regs))
        cru_reg_set_field(0x82C, 7, 1, 0)  // sclk_uart3_src gate disable
        cru_reg_set_field(0x82C, 12, 1, 0)  // pclk_uart3 gate disable
    elif 4 == devnum:
        map_hw_addr(UART4_BASE, SizeOf(UART_REG), ^pointer(%regs))
        cru_reg_set_field(0x82C, 8, 1, 0)  // sclk_uart4_src gate disable
        cru_reg_set_field(0x82C, 13, 1, 0)  // pclk_uart4 gate disable
    else:
        return false
    endif

    periphclock = 24000000

    // LCR
    tmp = (0
        | (3 << 0) // DATALEN(2): 0 = 5-bit, 1 = 6-bit, 2 = 7-bit, 3 = 8-bit
        | (0 << 2) // STOPLEN: 0 = 1 stop bit, 1 = 2 stop bits
        | (0 << 3) // PE: parity enable
        | (0 << 4) // EVEN_PARITY: 1 = even parity
        | (0 << 5) // STICK_PARITY
        | (0 << 6) // BREAK
        | (1 << 7) // DIVISOR_LATCH_ACCESS: 1 = access the divisor latches
        )
    if parity:
        tmp |= (1 << 3)  // PE: parity enable
        if not oddparity:
            tmp |= (1 << 4)
        endif
    endif
    if halfstopbits == 4:
        tmp |= (1 << 2)
    endif
    regs.LCR = tmp
    if regs.LCR <> 0: endif

    regs.MCR = 0  // disable auto-flow
    if regs.MCR <> 0: endif

    regs.FCR = (0
        | (1 << 0) // FIFO_EN
        | (1 << 1) // RCVR_FIFO_RST
        | (1 << 2) // XMIT_FIFO_RST
        | (0 << 3) // DMA_MODE: 0 = single DMA transfers, 1 = multi DMA transfers
        | (0 << 4) // TX_FIFO_TRIG(2): 0 = 8 bytes
        | (0 << 6) // RX_FIFO_TRIG(2): 0 = 8 bytes
        )
    if regs.IIR <> 0: endif  // FCR is write only, the IIR has the same address

    SetBaudRate(baudrate)

    regs.LCR &= ~(1 << 7)  // disable divisor latch, enabling the access to the FIFO data
    if regs.LCR <> 0: endif

    initialized = true
    return true
endfunc

func OHwUart_impl.SetBaudRate(abaudrate : int) -> bool:
    baudrate = abaudrate

    regs.LCR |= (1 << 7)  // enable divisor latch

    var brdiv : uint = (periphclock >> 4) div baudrate

    regs.DLL = (brdiv & 0xFF)
    regs.DLH = (brdiv >> 8)

    regs.LCR &= ~(1 << 7)  // disable divisor latch, enabling the access to the FIFO data

    return true
endfunc

func OHwUart_impl.TrySendByte(ach : byte) -> bool:
    if regs.USR & (1 << 1) <> 0:  // transmitter FIFO not full?
        regs.THR = ach
        return true
    else:
        return false
    endif
endfunc

func OHwUart_impl.TryRecvByte(ach : refout byte) -> bool:
    if regs.LSR & (1 << 0) <> 0:  // Receive FIFO not empty?
        ach = regs.RBR
        return true
    else:
        return false
    endif
endfunc

func OHwUart_impl.SendFinished() -> bool:
    if regs.LSR & (1 << 6) <> 0:  // transmitter empty?
        return true
    else:
        return false
    endif
endfunc