use ^/platform

func ClockCntInit()

#ifdef CPU_ARMM
	#if __CORTEX_M >= 3

		func ClockCnt() -> uint32  [[inline]]:
			return DWT.CYCCNT
		endfunc
	#else
		// soc specific solution using a timer

		var clockcnt32_high : uint32
		var last_clockcnt16 : uint16

		func ClockCnt() -> uint32  [[inline]]:
			var t0 : uint16 = #{ifdef TIM14} TIM14.CNT #{else} TIM21.CNT #{endif}
			if t0 < last_clockcnt16:
				clockcnt32_high += 0x10000
			endif
			last_clockcnt16 = t0
			return clockcnt32_high + t0
		endfunc

	#endif
#endif

#ifdef CPU_RV32I
	func ClockCnt() -> uint32  [[inline]]:
		return cpu_csr_read(0x7E2)  // use the mpccr instead of the mtime
	endfunc
#endif

implementation

#ifdef CPU_ARMM
  #if __CORTEX_M >= 3

	func ClockCntInit():
		CoreDebug.DEMCR |= CoreDebug_DEMCR_TRCENA_Msk
		#ifdef CPU_ARM_M7F
			DWT.LAR  = 0xC5ACCE55	// this is requied for Cortex M7
		#endif
		DWT.CTRL |= 1
	endfunc

  #else  // Cortex-M0

	func ClockCntInit():

		#ifdef TIM14
			#ifdef RCC_APBENR2_TIM14EN
				RCC.APBENR2 |= RCC_APBENR2_TIM14EN
			#else
				RCC.APB1ENR |= RCC_APB1ENR_TIM14EN
			#endif
			const CCTIMER :? = TIM14
		#else
			RCC.APB2ENR |= RCC_APB2ENR_TIM21EN
			const CCTIMER :? = TIM21
		#endif

		CCTIMER.CR1 = 0
		CCTIMER.PSC = 0 // count every clock
		CCTIMER.CR1 = 1
		CCTIMER.EGR = 1 // reinit, start the timer
	endfunc

  #endif
#endif

#ifdef CPU_RV32I

	func ClockCntInit():
		cpu_csr_write(0x7E0, 1)  // = mpcer[0] = count clock cycles
		cpu_csr_write(0x7E1, 1)  // = mpcmer[0] = enable counting
	endfunc

#endif